<script>
(function () {
  const root = document.getElementById("root");
  const tl = gsap.timeline({ paused: true });

  // Camera helper: frame page point (cx, cy) at zoom z in the 1920x1080 viewport.
  const view = (cx, cy, z) => ({ x: 960 - cx * z, y: 540 - cy * z, scale: z });
  const cut = (sel, [cx, cy, z], t) => tl.set(sel, view(cx, cy, z), t);
  const move = (sel, [cx, cy, z], t, dur, ease = "power2.inOut") => tl.to(sel, { ...view(cx, cy, z), duration: dur, ease }, t);
  // Cursor: glide to (x, y) in page px, then click with a ripple at the tip.
  const click = (cur, rip, [x0, y0], [x, y], tArrive, dur, tClick) => {
    tl.fromTo(cur, { opacity: 0, x: x0, y: y0 }, { opacity: 1, x, y, duration: dur, ease: "power3.out" }, tArrive - dur);
    tl.to(cur, { scale: 0.8, duration: 0.07, yoyo: true, repeat: 1, transformOrigin: "0 0" }, tClick);
    tl.set(rip, { left: x, top: y }, 0);
    tl.fromTo(rip, { scale: 0.2, opacity: 1 }, { scale: 1.6, opacity: 0, duration: 0.45, ease: "power2.out", immediateRender: false }, tClick);
  };

  // ---- Audio-reactive: music RMS drives the background glow (--rms) ----
  const RMS = window.MUSIC_RMS || [];
  for (let f = 0; f < RMS.length; f++) tl.call((v) => root.style.setProperty("--rms", v), [RMS[f]], f / 30);

  // ---- Music bed ----
  tl.fromTo("#bgm", { volume: 0 }, { volume: 0.2, duration: 0.8, ease: "none" }, 0);
  tl.to("#bgm", { volume: 0, duration: 1.4, ease: "none" }, 23.1);

  // ---- Scene 1: hook (0 - 5.0) ----
  tl.fromTo("#gut", { opacity: 0, y: 178, scale: 1.08 }, { opacity: 1, y: 118, scale: 1, duration: 0.5, ease: "power3.out" }, 0.25);
  tl.fromTo("#strike", { scaleX: 0 }, { scaleX: 1, duration: 0.3, ease: "power2.in" }, 3.2);
  tl.to("#gut", { color: "#71717a", scale: 0.9, y: 0, duration: 0.35, ease: "power2.out" }, 3.45);
  tl.fromTo("#model", { opacity: 0, scale: 1.4, y: 20 }, { opacity: 1, scale: 1, y: 0, duration: 0.45, ease: "expo.out" }, 3.55);
  tl.to("#s1-stage", { opacity: 0, scale: 1.15, duration: 0.35, ease: "power2.in" }, 4.65);

  // ---- Scene 2: landing -> nation -> league (5.0 - 9.2) ----
  tl.fromTo("#cam-landing", { opacity: 0, ...view(960, 400, 1.6) }, { opacity: 1, ...view(960, 470, 1.4), duration: 2.0, ease: "power2.out" }, 5.0);
  tl.fromTo("#ring-picker", { opacity: 0 }, { opacity: 1, duration: 0.2 }, 7.05);
  click("#cur-landing", "#rip-landing", [1400, 900], [980, 600], 7.05, 0.7, 7.35);
  cut("#cam-nations", [958, 517, 1.3], 7.45);
  tl.fromTo("#cam-nations", { opacity: 0 }, { opacity: 1, duration: 0.12 }, 7.45);
  click("#cur-nations", "#rip-nations", [980, 600], [1215, 610], 7.9, 0.4, 8.0);
  cut("#cam-leagues", [960, 520, 1.5], 8.2);
  click("#cur-leagues", "#rip-leagues", [1215, 610], [680, 618], 8.45, 0.25, 8.5);

  // ---- Flag wipe (8.55 - 10.0) ----
  tl.fromTo("#wipe", { xPercent: -101 }, { xPercent: 0, duration: 0.55, ease: "power3.inOut" }, 8.6);
  tl.to("#wipe", { xPercent: 101, duration: 0.55, ease: "power3.inOut" }, 9.3);

  // ---- Scene 3a: fixtures, zoom to Ajax vs Excelsior (9.2 - 10.65) ----
  cut("#cam-fixtures", [960, 560, 1.0], 9.2);
  move("#cam-fixtures", [900, 636, 1.45], 9.6, 0.6);
  tl.fromTo("#ring-row", { opacity: 0 }, { opacity: 1, duration: 0.25 }, 10.0);
  click("#cur-fixtures", "#rip-fixtures", [900, 820], [556, 632], 10.2, 0.45, 10.3);
  tl.to("#cam-fixtures", { scale: "+=0.25", x: "-=180", y: "-=160", opacity: 0, duration: 0.25, ease: "power2.in" }, 10.4);

  // ---- Scene 3b: match page (10.55 - 15.25) ----
  const HERO = [960, 492, 1.75], LADDER = [960, 846, 1.6];
  tl.fromTo("#cam-match", { opacity: 0, ...view(960, 492, 2.0) }, { opacity: 1, ...view(...HERO), duration: 0.45, ease: "power3.out" }, 10.55);
  // beat-locked: glow on the predicted total at the 10.93s strong cue
  tl.fromTo("#glow-total", { opacity: 0, scale: 0.6 }, { opacity: 1, scale: 1.1, duration: 0.3, ease: "power2.out" }, 10.93);
  tl.to("#glow-total", { opacity: 0, duration: 0.8 }, 11.6);
  tl.to("#cam-match", { ...view(960, 500, 1.6), duration: 1.3, ease: "sine.inOut" }, 11.1);
  // beat-locked: arrive at the probability ladder on the 13.11s strong cue
  move("#cam-match", LADDER, 12.45, 0.66);
  tl.fromTo("#ring-ladder", { opacity: 0, scale: 1.2 }, { opacity: 1, scale: 1, duration: 0.3, ease: "back.out(2)" }, 13.15);
  tl.to("#ring-ladder", { opacity: 0, duration: 0.25 }, 13.95);
  move("#cam-match", HERO, 14.0, 0.5);
  click("#cur-match", "#rip-match", [1000, 640], [712, 455], 14.7, 0.5, 14.8);
  tl.to("#cam-match", { ...view(712, 455, 2.2), opacity: 0, duration: 0.3, ease: "power2.in" }, 14.95);

  // ---- Scene 4: Ajax team page (15.1 - 19.4) ----
